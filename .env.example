# ---- Public (safe in the browser) ------------------------------------------
# PostHog project API key + ingestion host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# `next dev` never sends events unless this is "true" (keeps dev out of production data).
NEXT_PUBLIC_ANALYTICS_ENABLE_DEV=false
# "true" logs every event + its sanitized properties to the console, and sends uncompressed payloads.
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# ---- Server only (never prefix with NEXT_PUBLIC_) ---------------------------
# Password for /admin/analytics (min 8 chars). Unset = dashboard disabled.
ANALYTICS_ADMIN_SECRET=
# Personal API key with the "Query Read" scope, and the numeric project id.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Optional: PostHog app host for the query API (derived from NEXT_PUBLIC_POSTHOG_HOST if omitted).
POSTHOG_API_HOST=https://us.posthog.com
# Optional: timezone for dashboard times.
ANALYTICS_TIMEZONE=America/New_York

# ---- Guestbook (Supabase) — server only -------------------------------------
# Project URL (Settings → Data API / API Keys) and the SECRET key (sb_secret_…).
# Never use the secret key in a NEXT_PUBLIC_ variable. Run supabase/guestbook.sql once.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---- Site ---------------------------------------------------------------------
# Canonical URL for link previews, sitemap and robots.txt (defaults to https://jineshwarnariani.com).
NEXT_PUBLIC_SITE_URL=https://jineshwarnariani.com

# Optional: the dashboard ignores events before this moment (ISO 8601, e.g. 2026-09-27T00:00:00Z).
ANALYTICS_START=
